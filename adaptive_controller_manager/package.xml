<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adaptive_controller_manager</name>
  <version>0.0.0</version>
  <description>Arbiter/FSM node mediating pure_pursuit and mpc_path_tracking, and tire-parameter handoff between On-Track-SysID and mpc_path_tracking</description>
  <maintainer email="ebrahim.abdelghfar@micropolis.ai">Ebrahim</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>f1tenth_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>adaptive_controller_interfaces</depend>
  <depend>track_geometry_utils</depend>

  <exec_depend>pure_pursuit</exec_depend>
  <exec_depend>mpc_path_tracking</exec_depend>
  <exec_depend>on_track_sys_id</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
