<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>estimation_benchmark</name>
  <version>0.1.0</version>
  <description>ROS2 package for multi-step estimation benchmarking of identified vehicle dynamics models with academic metrics and optional tire force validation.</description>

  <maintainer email="ebrahimabdelghfar550@gmail.com">Ebrahim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>

  <!-- Optional: only needed when tire force benchmarking is enabled -->
  <exec_depend condition="$ENABLE_TIRE_FORCE_BENCHMARK == '1'">hellocm_msgs</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
